      "lines": [
        {
          "speaker": "officer",
          "text": "They filed your refusal as a fault.",
          "text_sha256": "6e7b53f7cc50aa59a723adc1ba51bf8f4d557338256d321857d783eaa742430d",
          "source_key": "archive-officer",
          "path": "audio/survival/voice/archive-officer.ogg",
