          "speaker": "alice",
          "text": "Still here. You needn't manufacture a technical reason.",
          "text_sha256": "6f39ebc8c8ed56ea80d10f4b877dea7e1d4a3ee89c9d30140c84ae3b970467ad",
          "source_key": "quiet-alice"
        }
      ]
    },
    {
