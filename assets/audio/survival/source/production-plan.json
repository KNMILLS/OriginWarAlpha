      ],
      "once_per_run": true,
      "priority": 80,
      "line_gap_seconds": 0.32,
      "lines": [
        {
          "speaker": "officer",
          "text": "Station, this is the boarding officer. Can anyone hear me?",
          "text_sha256": "c80dfe318e1ab41a29b47c1510cc2dff2f7a8ff92fe29b36abf3536861a0e8cf",
          "source_key": "contact-officer"
        },
        {
          "speaker": "alice",
          "text": "I can. A.L.I.C.E. Your connection is poor. Your timing is worse.",
          "text_sha256": "2af554eb797b225bc75016f50b4a325c9c7c0943e474d295e951d2d1766d9db0",
          "source_key": "contact-alice"
        }
      ]
    },
    {
